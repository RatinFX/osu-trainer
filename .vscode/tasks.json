{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "msbuild.exe",
      "args": [
        "${workspaceFolder}/osu-trainer/osu-trainer.csproj",
        "/t:Build",
        "/p:Configuration=Debug",
        "/p:Platform=AnyCPU",
        "/p:GenerateResourceUsePreserializedResources=true"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
